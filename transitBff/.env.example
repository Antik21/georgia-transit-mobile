# Development-only synthetic fixture. Do not use this file or its values in production.
BFF_MODE=development
BFF_HOST=127.0.0.1
BFF_PORT=8080
BFF_DIRECTORY_CACHE_TTL_SECONDS=14400
BFF_SHAPE_CACHE_TTL_SECONDS=86400
BFF_REALTIME_SINGLE_FLIGHT_SECONDS=15
BFF_FIXTURES_ENABLED=true

# Production requires separately implemented, reviewed city adapter credentials in an operator
# secret manager. No provider credential, provider URL, or provider selector is checked in here.
# BFF_MODE=production
# BFF_FIXTURES_ENABLED=false
