# Development-only synthetic fixture. Do not use this file or its values in production.
BFF_MODE=development
BFF_HOST=127.0.0.1
BFF_PORT=8080
BFF_DIRECTORY_CACHE_TTL_SECONDS=14400
BFF_SHAPE_CACHE_TTL_SECONDS=86400
BFF_REALTIME_SINGLE_FLIGHT_SECONDS=15
BFF_FIXTURES_ENABLED=true

# Optional operator-managed capability control plane. Set both physical (no symlink) POSIX path
# variables together; do not point production at this checked-in fixture example. The control
# file must be process-owned 0400/0600 and the pre-created state directory process-owned 0700.
# The document/state contain only normalized flags and metadata, never provider URLs/credentials.
# BFF_CAPABILITY_CONTROL_PATH=/operator-owned/transit-bff/capabilities.json
# BFF_CAPABILITY_CONTROL_STATE_DIR=/operator-owned/transit-bff/capability-state
BFF_CAPABILITY_CONTROL_POLL_SECONDS=30
BFF_CAPABILITY_CONTROL_HISTORY_LIMIT=20

# Production requires separately implemented, reviewed city adapter credentials in an operator
# secret manager. No provider credential, provider URL, or provider selector is checked in here.
# BFF_MODE=production
# BFF_FIXTURES_ENABLED=false
# BFF_CAPABILITY_CONTROL_PATH=/operator-owned/transit-bff/capabilities.json
# BFF_CAPABILITY_CONTROL_STATE_DIR=/operator-owned/transit-bff/capability-state
