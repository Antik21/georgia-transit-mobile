# Development-only synthetic fixture. Do not use this file or its values in production.
BFF_MODE=development
BFF_HOST=127.0.0.1
BFF_PORT=8080
BFF_DIRECTORY_CACHE_TTL_SECONDS=14400
BFF_SHAPE_CACHE_TTL_SECONDS=86400
BFF_REALTIME_SINGLE_FLIGHT_SECONDS=15
BFF_FIXTURES_ENABLED=true

# The internal Prometheus 0.0.4 exporter is enabled by default, but must be reached only through
# deployment-private ingress/ACLs. It exports no request IDs, URLs, query values, public IDs,
# coordinates, headers, contacts, approval references, error text, or payloads.
BFF_METRICS_ENABLED=true

# Synthetic upstream probes are disabled by default so local development, CI, and an unconfigured
# deployment never contact a real provider. If enabled, the interval is strictly 60–300 seconds
# and every target must be explicitly declared by its server-only provider configuration.
BFF_PROBES_ENABLED=false
BFF_PROBE_INTERVAL_SECONDS=60

# Bounded in-process protection; no distributed/fleet-wide quota guarantee is implied.
BFF_CIRCUIT_FAILURE_THRESHOLD=3
BFF_CIRCUIT_WINDOW_SECONDS=60
BFF_CIRCUIT_OPEN_SECONDS=30

# Synthetic-probe schema drift latches only the affected capability. Production Transitous
# activation requires this true and the private capability-control state directory below.
BFF_SCHEMA_INTERLOCK_ENABLED=false
BFF_SCHEMA_DRIFT_THRESHOLD=3
BFF_SCHEMA_DRIFT_WINDOW_SECONDS=300

# Optional operator-managed capability control plane. Set both physical (no symlink) POSIX path
# variables together; do not point production at this checked-in fixture example. The control
# file must be process-owned 0400/0600 and the pre-created state directory process-owned 0700.
# The document/state contain only normalized flags and metadata, never provider URLs/credentials.
# BFF_CAPABILITY_CONTROL_PATH=/operator-owned/transit-bff/capabilities.json
# BFF_CAPABILITY_CONTROL_STATE_DIR=/operator-owned/transit-bff/capability-state
BFF_CAPABILITY_CONTROL_POLL_SECONDS=30
BFF_CAPABILITY_CONTROL_HISTORY_LIMIT=20

# Production requires separately implemented, reviewed city adapter credentials in an operator
# secret manager. No provider credential, provider URL, or provider selector is checked in here.
# BFF_MODE=production
# BFF_FIXTURES_ENABLED=false
# BFF_CAPABILITY_CONTROL_PATH=/operator-owned/transit-bff/capabilities.json
# BFF_CAPABILITY_CONTROL_STATE_DIR=/operator-owned/transit-bff/capability-state
# BFF_SCHEMA_INTERLOCK_ENABLED=true

# Transitous hosted fallback is disabled by default. Setting TRANSITOUS_ENABLED=true is a
# deliberate production activation: only do so after a recorded written eligibility review of
# https://transitous.org/api/ and after agreeing a meaningful technical contact. The reference
# values are non-secret change/ticket identifiers and are never returned or logged by the BFF.
# The client accepts only the exact https://api.transitous.org origin and always sends
# GeorgiaTransitBff/<version> (contact: <contact>) as User-Agent.
TRANSITOUS_ENABLED=false
# BFF_RELEASE_VERSION=2026.09.08
# TRANSITOUS_BASE_URL=https://api.transitous.org
# TRANSITOUS_CONTACT=transit-operations@example.org
# TRANSITOUS_ELIGIBILITY_ACKNOWLEDGED=false
# TRANSITOUS_ELIGIBILITY_REFERENCE=legal-approval-123
# TRANSITOUS_CONTACT_ACKNOWLEDGED=false
# Optional seed for the server-only Tbilisi stop allowlist: at most 128 unique raw upstream IDs,
# comma-separated, no whitespace. Unknown public stop IDs never trigger upstream traffic.
# TRANSITOUS_TBILISI_STOP_IDS=approved-stop-a,approved-stop-b
# One optional probe stop must be one of the approved IDs above. It stays server-only and is never
# emitted in logs or metrics. `false` avoids a realtime freshness alert for schedule-only data.
# TRANSITOUS_PROBE_STOP_ID=approved-stop-a
# TRANSITOUS_PROBE_REALTIME_EXPECTED=false

# Routing has a separate approval gate because hosted routing/heavy or multi-user use requires
# explicit upstream contact/approval. Omitting either value keeps tripPlanning=false and prevents
# every /plan request, even if arrivals are enabled.
# TRANSITOUS_ROUTING_APPROVAL_ACKNOWLEDGED=false
# TRANSITOUS_ROUTING_APPROVAL_REFERENCE=transitous-email-20260908
